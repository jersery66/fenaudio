# 网易云音乐 API（使用 NeteaseCloudMusicApi 服务）
NETEASE_API_BASE=http://localhost:3000

# 网易云音乐 VIP Cookie（重要！不配置则VIP歌曲只能试听几十秒）
# 获取方式：
# 1. 在浏览器登录 music.163.com（需VIP账号）
# 2. 打开开发者工具(F12) -> Application -> Cookies
# 3. 复制完整 Cookie 值粘贴到下方
# 4. 推荐使用网易云黑胶VIP账号以获取无损音质
NETEASE_COOKIE=

# 大模型 API
AI_API_BASE=https://api.openai.com/v1
AI_API_KEY=your-api-key-here
AI_MODEL=gpt-4o

# 天气 API（OpenWeather）
WEATHER_API_KEY=your-weather-api-key-here
WEATHER_CITY=Beijing

# TTS 服务（阿里云 DashScope）
# 获取方式：
# 1. 访问 https://dashscope.console.aliyun.com/ 开通服务
# 2. 在 API-KEY 管理中创建 API Key
# 3. 可选模型：cosyvoice-v1, cosyvoice-v2
# 4. 可选音色：longxiaochun, longlaotie, longshuo, longyue, longjing, longmiao 等
# 5. 也支持自定义音色克隆，详见 DashScope 文档
DASHSCOPE_API_KEY=your-dashscope-api-key-here
TTS_MODEL=cosyvoice-v1
TTS_VOICE=longxiaochun

# 服务器配置
PORT=3200
